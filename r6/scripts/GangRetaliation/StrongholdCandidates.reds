    // Index of the row whose journal hash matches, or -1.
    public static func FindByHash(hash: Uint32) -> Int32 {
        let hashes: array<Uint32> = GRStrongholdCandidates.JournalHashes();
        let i: Int32 = 0;
        while i < ArraySize(hashes) {
            if hashes[i] == hash {
                return i;
            };
            i += 1;
        };
        return -1;
    }
}
